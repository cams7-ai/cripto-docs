    "ddl": {
      "events": "CREATE TABLE events (event_id TEXT PRIMARY KEY,source_hash TEXT NOT NULL,data TEXT NOT NULL,status TEXT NOT NULL,preferred TEXT NOT NULL,retry_at INTEGER NOT NULL,coalesced_into TEXT REFERENCES events(event_id))",
      "attempts": "CREATE TABLE attempts (event_id TEXT NOT NULL REFERENCES events(event_id),channel TEXT NOT NULL,attempt_no INTEGER NOT NULL,started_at INTEGER NOT NULL,lease_until INTEGER NOT NULL,finished_at INTEGER,outcome TEXT NOT NULL,PRIMARY KEY(event_id,channel,attempt_no))",
      "clock": "CREATE TABLE clock (id INTEGER PRIMARY KEY CHECK(id=1),last_attempt_at INTEGER NOT NULL)",
      "queue_ready": "CREATE INDEX queue_ready ON events(status,retry_at)",
      "immutable_event_payload": "CREATE TRIGGER immutable_event_payload BEFORE UPDATE OF event_id,source_hash,data ON events BEGIN SELECT RAISE(ABORT,'immutable notification event'); END",
      "immutable_attempt": "CREATE TRIGGER immutable_attempt BEFORE UPDATE ON attempts WHEN OLD.outcome!='IN_FLIGHT' BEGIN SELECT RAISE(ABORT,'immutable completed attempt'); END",
      "immutable_attempt_delete": "CREATE TRIGGER immutable_attempt_delete BEFORE DELETE ON attempts BEGIN SELECT RAISE(ABORT,'immutable attempt'); END"
    },
