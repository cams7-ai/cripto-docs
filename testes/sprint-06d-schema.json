  "continuous": {
    "schema_version": 1,
    "quick_check": "ok",
    "foreign_key_check": [],
    "ddl": {
      "journal": "CREATE TABLE journal (seq INTEGER PRIMARY KEY,event_key TEXT NOT NULL UNIQUE,kind TEXT NOT NULL,at INTEGER NOT NULL,payload TEXT NOT NULL,payload_hash TEXT NOT NULL,previous_hash TEXT NOT NULL,chain_hash TEXT NOT NULL,state_hash TEXT NOT NULL)",
      "postings": "CREATE TABLE postings (seq INTEGER NOT NULL REFERENCES journal(seq),idx INTEGER NOT NULL,asset TEXT NOT NULL CHECK(asset IN ('USDT','BTC')),account TEXT NOT NULL,quantity TEXT NOT NULL,PRIMARY KEY(seq,idx))",
      "projection": "CREATE TABLE projection (id INTEGER PRIMARY KEY CHECK(id=1),version INTEGER NOT NULL,data TEXT NOT NULL)",
      "orders": "CREATE TABLE orders (order_id TEXT PRIMARY KEY,data TEXT NOT NULL)",
      "fills": "CREATE TABLE fills (fill_id TEXT PRIMARY KEY,order_id TEXT NOT NULL REFERENCES orders(order_id),seq INTEGER NOT NULL REFERENCES journal(seq),data TEXT NOT NULL)",
      "cycles": "CREATE TABLE cycles (close_time INTEGER PRIMARY KEY,decision_id TEXT NOT NULL UNIQUE,seq INTEGER NOT NULL REFERENCES journal(seq),data TEXT NOT NULL)",
      "configurations": "CREATE TABLE configurations (generation INTEGER PRIMARY KEY,seq INTEGER NOT NULL REFERENCES journal(seq),data TEXT NOT NULL)",
      "controls": "CREATE TABLE controls (request_id TEXT PRIMARY KEY,seq INTEGER NOT NULL REFERENCES journal(seq),data TEXT NOT NULL)",
      "notification_events": "CREATE TABLE notification_events (event_id TEXT PRIMARY KEY,seq INTEGER NOT NULL REFERENCES journal(seq),source_hash TEXT NOT NULL,data TEXT NOT NULL)",
      "notification_seq": "CREATE INDEX notification_seq ON notification_events(seq)",
      "immutable_journal_UPDATE": "CREATE TRIGGER immutable_journal_UPDATE BEFORE UPDATE ON journal BEGIN SELECT RAISE(ABORT,'immutable continuous history'); END",
      "immutable_journal_DELETE": "CREATE TRIGGER immutable_journal_DELETE BEFORE DELETE ON journal BEGIN SELECT RAISE(ABORT,'immutable continuous history'); END",
      "immutable_postings_UPDATE": "CREATE TRIGGER immutable_postings_UPDATE BEFORE UPDATE ON postings BEGIN SELECT RAISE(ABORT,'immutable continuous history'); END",
      "immutable_postings_DELETE": "CREATE TRIGGER immutable_postings_DELETE BEFORE DELETE ON postings BEGIN SELECT RAISE(ABORT,'immutable continuous history'); END",
      "immutable_fills_UPDATE": "CREATE TRIGGER immutable_fills_UPDATE BEFORE UPDATE ON fills BEGIN SELECT RAISE(ABORT,'immutable continuous history'); END",
      "immutable_fills_DELETE": "CREATE TRIGGER immutable_fills_DELETE BEFORE DELETE ON fills BEGIN SELECT RAISE(ABORT,'immutable continuous history'); END",
      "immutable_cycles_UPDATE": "CREATE TRIGGER immutable_cycles_UPDATE BEFORE UPDATE ON cycles BEGIN SELECT RAISE(ABORT,'immutable continuous history'); END",
      "immutable_cycles_DELETE": "CREATE TRIGGER immutable_cycles_DELETE BEFORE DELETE ON cycles BEGIN SELECT RAISE(ABORT,'immutable continuous history'); END",
      "immutable_configurations_UPDATE": "CREATE TRIGGER immutable_configurations_UPDATE BEFORE UPDATE ON configurations BEGIN SELECT RAISE(ABORT,'immutable continuous history'); END",
      "immutable_configurations_DELETE": "CREATE TRIGGER immutable_configurations_DELETE BEFORE DELETE ON configurations BEGIN SELECT RAISE(ABORT,'immutable continuous history'); END",
      "immutable_controls_UPDATE": "CREATE TRIGGER immutable_controls_UPDATE BEFORE UPDATE ON controls BEGIN SELECT RAISE(ABORT,'immutable continuous history'); END",
      "immutable_controls_DELETE": "CREATE TRIGGER immutable_controls_DELETE BEFORE DELETE ON controls BEGIN SELECT RAISE(ABORT,'immutable continuous history'); END",
      "immutable_notification_events_UPDATE": "CREATE TRIGGER immutable_notification_events_UPDATE BEFORE UPDATE ON notification_events BEGIN SELECT RAISE(ABORT,'immutable continuous history'); END",
      "immutable_notification_events_DELETE": "CREATE TRIGGER immutable_notification_events_DELETE BEFORE DELETE ON notification_events BEGIN SELECT RAISE(ABORT,'immutable continuous history'); END"
